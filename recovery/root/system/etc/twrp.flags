# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK
#
# /data encryption must match recovery.fstab / ROM fstab (A16 FBE v2 + wrappedkey)

# mount point  fstype device                             device2              flags
/boot          emmc   /dev/block/bootdevice/by-name/boot
/dtbo          emmc   /dev/block/bootdevice/by-name/dtbo                         flags=backup=1;display="Dtbo";flashimg=1
/cache         ext4   /dev/block/bootdevice/by-name/cache
/recovery      emmc   /dev/block/bootdevice/by-name/recovery                     flags=backup=1
/system_root   ext4   /dev/block/mapper/system                                   flags=display="System";backup=0;wipeingui;logical
/system_ext    ext4   /dev/block/mapper/system_ext                               flags=display="System_EXT";backup=0;wipeingui;logical
/product       ext4   /dev/block/mapper/product                                  flags=display="Product";backup=0;wipeingui;logical
/vendor        ext4   /dev/block/mapper/vendor                                   flags=display="Vendor";backup=0;wipeingui;logical
/odm           ext4   /dev/block/mapper/odm                                      flags=display="Odm";backup=0;wipeingui;logical

/system_image  emmc   /dev/block/mapper/system                                   flags=display="System Image";backup=1;flashimg=1;logical
/system_ext_image emmc /dev/block/mapper/system_ext                              flags=display="System_EXT Image";backup=1;flashimg=1;logical
/product_image emmc   /dev/block/mapper/product                                  flags=display="Product Image";backup=1;flashimg=1;logical
/vendor_image  emmc   /dev/block/mapper/vendor                                   flags=display="Vendor Image";backup=1;flashimg=1;logical
/odm_image     emmc   /dev/block/mapper/odm                                      flags=display="Odm Image";backup=1;flashimg=1;logical

/super_system  emmc   /dev/block/bootdevice/by-name/system                       flags=display="Super (system)";backup=1
/super_vendor  emmc   /dev/block/bootdevice/by-name/vendor                       flags=display="Super (vendor)";backup=1
/super_odm     emmc   /dev/block/bootdevice/by-name/odm                          flags=display="Super (odm)";backup=1

/metadata      ext4   /dev/block/bootdevice/by-name/metadata                     flags=display="Metadata";backup=1
/data          ext4   /dev/block/bootdevice/by-name/userdata                     flags=fileencryption=aes-256-xts:aes-256-cts:v2
/data          f2fs   /dev/block/bootdevice/by-name/userdata                     flags=fileencryption=aes-256-xts:aes-256-cts:v2
/firmware      vfat   /dev/block/bootdevice/by-name/modem                        flags=display="Firmware";mounttodecrypt
/misc          emmc   /dev/block/bootdevice/by-name/misc
/modem         emmc   /dev/block/bootdevice/by-name/modem                        flags=backup=1;display="Modem"
/bluetooth     emmc   /dev/block/bootdevice/by-name/bluetooth                    flags=backup=1;subpartitionof=/modem
/dsp           emmc   /dev/block/bootdevice/by-name/dsp                          flags=backup=1;subpartitionof=/modem
/efs1          emmc   /dev/block/bootdevice/by-name/modemst1                     flags=backup=1;display=EFS
/efs2          emmc   /dev/block/bootdevice/by-name/modemst2                     flags=backup=1;subpartitionof=/efs1
/efsc          emmc   /dev/block/bootdevice/by-name/fsc                          flags=backup=1;subpartitionof=/efs1
/efsg          emmc   /dev/block/bootdevice/by-name/fsg                          flags=backup=1;subpartitionof=/efs1
/persist       ext4   /dev/block/bootdevice/by-name/persist                      flags=display="Persist"
/persist_image     emmc    /dev/block/bootdevice/by-name/persist                 flags=display="Persist";flashimg=1;backup=1
/vbmeta        emmc   /dev/block/bootdevice/by-name/vbmeta                       flags=display="Vbmeta";flashimg=1;backup=1

# Removable storage
/usb_otg       auto   /dev/block/sdg1                    /dev/block/sdg          flags=fsflags=utf8;display="USB-OTG";storage;wipeingui;removable
