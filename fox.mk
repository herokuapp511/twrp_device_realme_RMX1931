# Target device / architecture
FOX_USE_TWRP_RECOVERY_IMAGE_BUILDER := 1
FOX_BUILD_DEVICE := samurai
FOX_TARGET_DEVICES := samurai,RMX1931,RMX1931L1,RMX1931CN
OF_MAINTAINER ?= NAYEM
FOX_BUILD_TYPE := Stable
FOX_MAINTAINER_PATCH_VERSION := 1
FOX_BUILD_TYPE ?= Unofficial

# Screen / Display Settings (Realme X2 Pro: 1080x2400, teardrop center notch)
OF_SCREEN_H := 2400
OF_STATUS_H := 80
OF_STATUS_INDENT_LEFT := 48
OF_STATUS_INDENT_RIGHT := 48
OF_CLOCK_POS := 1
OF_ALLOW_DISABLE_NAVBAR := 0
OF_USE_GREEN_LED := 0

# Shell & Utilities
FOX_USE_BASH_SHELL := 1
FOX_ASH_IS_BASH := 1
FOX_USE_NANO_EDITOR := 1
FOX_USE_TAR_BINARY := 1
FOX_USE_SED_BINARY := 1
FOX_USE_XZ_UTILS := 1
FOX_REPLACE_BUSYBOX_CAT := 1
FOX_REPLACE_TOOLBOX_GETPROP := 1

# Magisk & Flashing Features
OF_USE_MAGISKBOOT := 1
OF_USE_MAGISKBOOT_FOR_ALL_PATCHES := 1
OF_DONT_PATCH_ENCRYPTED_DEVICE := 1
OF_NO_TREBLE_COMPATIBILITY_CHECK := 1
OF_PATCH_AVB20 := 1
FOX_DELETE_AROMAFM := 1
FOX_BUGGED_AOSP_ARB_WORKAROUND := 1546300800
OF_DISABLE_MIUI_SPECIFIC_FEATURES := 1
OF_ENABLE_LPTOOLS := 0

# Backup Settings
OF_SKIP_MULTIUSER_FOLDERS_BACKUP := 1
OF_QUICK_BACKUP_LIST := /boot;/data;/system_root;/vendor;/modem;

# Realme / OZIP Decryption Support
OF_SUPPORT_OZIP := 1
OF_OZIP_DECRYPT_KEY := 1c4c1ea3a12531ae491b21bb31613c11

# Keymaster & Decryption (fixes: TW_FORCE_KEYMASTER_VER requires OF_DEFAULT_KEYMASTER_VERSION)
OF_DEFAULT_KEYMASTER_VERSION := 4.0
OF_KEEP_FORCED_KEYMASTER := true

# Flashlight (disabled by default; enable if sysfs node is tested)
OF_FLASHLIGHT_ENABLE := 0
